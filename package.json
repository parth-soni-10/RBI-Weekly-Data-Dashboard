{
  "name": "rbi-weekly-dashboard",
  "version": "1.2.0",
  "description": "Server-side scrapers and the Cloudflare Worker for the RBI weekly reserves dashboard + live crude oil data + macro context (FII/FPI flows, FX intervention, G-Sec, REER, tax receipts)",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node scripts/check-syntax.js",
    "test": "node --test",
    "refresh": "node scripts/refresh-static.js",
    "refresh:check": "node scripts/refresh-static.js --check",
    "fetch:data": "node scripts/fetch-all.js && node scripts/make-rss.js",
    "fetch:debt": "node scripts/fetch-debt-rankings.js",
    "snapshot:fng": "node scripts/snapshot-sentiment.js",
    "snapshot:fii": "node scripts/snapshot-fii-dii.js",
    "update:fwd": "node scripts/update-fwd-series.js",
    "update:fwd-monthly": "node scripts/update-fwd-monthly.js",
    "rss": "node scripts/make-rss.js"
  },
  "dependencies": {
    "node-xlsx": "^0.23.0"
  }
}
