# Dependencies
node_modules/

# Netlify build output (esbuild bundles functions here, regenerated each deploy)
.netlify/

# Environment & secrets
.env
.env.*
!.env.example

# Lockfiles — npm's package-lock.json IS tracked (deterministic installs).
# Block competing lockfiles so a different package manager can't sneak in.
yarn.lock
pnpm-lock.yaml

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build / cache artifacts
dist/
build/
.cache/

# Crude-import data dumps (regenerated locally, never commit).
# Live data is fetched on-demand from /.netlify/functions/fetch-crude;
# the india_crude_import_data folder is local-only supplemental cache.
public/india_crude_import_data/

# Freebuff Desktop local state (SQLite + WAL files sit in repo root)
.freebuff/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/
.aider*
.fleet/
.continue/

# Coverage / test output
coverage/
.nyc_output/

# Misc local-process state
*.local
*.pid
*.seed
