# Normalize text to LF so Netlify (Linux) builds match what contributors save locally.
# NOTE: The first commit after adding this file should run `git add --renormalize .`
# to bulk-normalize any existing CRLF files in a single "chore: renormalize line endings"
# commit. Without that step, every JS/HTML/MD file shows up as a huge noise diff on
# the next `git add` because the index will rewrite each line ending on save.
* text=auto eol=lf

# Explicit binary marks so git never tries to fix line endings on these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
